# Copy this file to .env for local development. Never commit real credentials.

# HTTP server
PORT=3000
HOST=127.0.0.1

# Redis must be the server built from this checkout with mgetttl.so loaded.
REDIS_URL=redis://127.0.0.1:6379

# Cookie policy. Keep false only for plain-http localhost development; use true
# behind HTTPS in every non-local deployment.
SESSION_COOKIE_NAME=session
COOKIE_SECURE=false

# Session lifetime policy (milliseconds).
# The storage adapter defaults to 30 minutes idle and 8 hours absolute when these
# values are omitted. Values must be positive integers; renewal cannot pass the
# absolute deadline.
SESSION_IDLE_TTL_MS=1800000
SESSION_ABSOLUTE_TTL_MS=28800000

# Optional paths used by npm test's temporary Redis helper. Leave unset when the
# helper can discover src/redis-server and src/modules/mgetttl.so in this checkout.
# REDIS_SERVER=/absolute/path/to/redis-server
# MGETTTL_MODULE=/absolute/path/to/mgetttl.so
# REDIS_PORT=6379
